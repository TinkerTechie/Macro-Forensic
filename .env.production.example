# Frontend Production Env
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Backend Production Env (mfas/.env)
GROQ_API_KEY=your_groq_production_key
LLAMA_CLOUD_API_KEY=your_llama_cloud_production_key
DATABASE_URL=postgresql://mfas_user:strong_password@postgres:5432/mfas
NEO4J_URI=bolt://neo4j:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=strong_neo4j_password
QDRANT_URL=http://qdrant:6333
ALLOWED_ORIGINS=https://yourdomain.com
